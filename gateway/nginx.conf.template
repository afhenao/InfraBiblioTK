# Gateway de BiblioTK: un solo origen para todo (apps y APIs). Así hay una sola cookie de sesión,
# no hace falta CORS y cada servicio conserva su prefijo de rutas de siempre.
# Los nombres (login, perfil, front-user…) son los servicios de Docker Compose y de Kubernetes:
# el mismo archivo sirve para los dos. Es una plantilla: al arrancar, la imagen de nginx reemplaza
#   ${NGINX_LOCAL_RESOLVERS}  DNS del contenedor (Docker: 127.0.0.11; Kubernetes: kube-dns)
#   ${DOMINIO}                 sufijo de los nombres (vacío en Compose; .bibliotk.svc.cluster.local en Kubernetes)
# Los nombres se resuelven en cada petición (cacheados 10 s): si un contenedor se recrea y cambia
# de IP, el gateway no sigue mandando a la vieja (que podía terminar siendo de otra app)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 8080;
    server_name _;

    # Portadas de hasta 3 MB más el resto del formulario
    client_max_body_size 5m;

    proxy_http_version 1.1;
    # Host original: Materiales arma con él la URL de las portadas locales
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Salud del propio gateway (Docker Compose y las sondas de Kubernetes), sin depender de nadie
    location = /gateway-salud {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # /interno es solo entre servicios (los backends avisan eventos): desde afuera no existe
    location /NotificacionesBiblioTK/interno/ {
        return 404;
    }

    # WebSocket de las notificaciones (solo WebSocket: no hace falta afinidad entre réplicas)
    location /NotificacionesBiblioTK/socket.io/ {
        set $destino notificaciones${DOMINIO};
        proxy_pass http://$destino:3006;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }

    location /NotificacionesBiblioTK/ { set $destino notificaciones${DOMINIO}; proxy_pass http://$destino:3006; }
    location /RegistroBiblioTK/ { set $destino registro${DOMINIO}; proxy_pass http://$destino:3000; }
    location /BiblioTK/ { set $destino login${DOMINIO}; proxy_pass http://$destino:3001; }
    location /PerfilBiblioTK/ { set $destino perfil${DOMINIO}; proxy_pass http://$destino:3002; }
    location /MaterialesBiblioTK/ { set $destino materiales${DOMINIO}; proxy_pass http://$destino:3003; }
    location /DashboardBibliotk/ { set $destino dashboard${DOMINIO}; proxy_pass http://$destino:3004; }
    location /PrestamosBiblioTK/ { set $destino prestamos${DOMINIO}; proxy_pass http://$destino:3005; }

    # Apps: se quita la subruta (rewrite) y el nginx de cada app sirve su compilado
    location = /lector        { return 301 /lector/; }
    location /lector/ {
        set $destino front-user${DOMINIO};
        rewrite ^/lector/(.*)$ /$1 break;
        proxy_pass http://$destino:8080;
    }
    location = /bibliotecario { return 301 /bibliotecario/; }
    location /bibliotecario/ {
        set $destino front-admin${DOMINIO};
        rewrite ^/bibliotecario/(.*)$ /$1 break;
        proxy_pass http://$destino:8080;
    }
    location = /superadmin    { return 301 /superadmin/; }
    location /superadmin/ {
        set $destino front-superadmin${DOMINIO};
        rewrite ^/superadmin/(.*)$ /$1 break;
        proxy_pass http://$destino:8080;
    }
    location = /movil         { return 301 /movil/; }
    location /movil/ {
        set $destino movil${DOMINIO};
        rewrite ^/movil/(.*)$ /$1 break;
        proxy_pass http://$destino:8080;
    }

    # Todo lo demás es la landing (/, /login, /register, /catalogo)
    location / { set $destino front${DOMINIO}; proxy_pass http://$destino:8080; }
}
