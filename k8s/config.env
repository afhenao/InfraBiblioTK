# Configuración común (sin secretos) que reciben todos los backends como variables de entorno.
# Detrás del gateway todo comparte el origen http://localhost (Service LoadBalancer en el puerto 80)
TZ=America/Bogota
DB_HOST=mariadb
DB_PORT=3306
DB_NAME=bibliotk
ALLOWED_ORIGIN_1=http://localhost
NOTIFICACIONES_URL=http://notificaciones:3006/NotificacionesBiblioTK
APP_USUARIO_URL=http://localhost/lector/
APP_ADMIN_URL=http://localhost/bibliotecario/
APP_SUPERADMIN_URL=http://localhost/superadmin/
REDIS_URL=redis://redis:6379
# QR de la landing: cambiar localhost por la IP del computador en la red Wi-Fi (ver CLAUDE.md)
MOVIL_URL=http://localhost/movil/
