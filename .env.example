# Copiar como .env en esta carpeta (Docker Compose lo lee solo). Nunca subir el .env real.
# Sin .env se usan valores de ejemplo, aceptables solo en el propio computador.
DB_USER=bibliotk
DB_PASSWORD=
DB_ROOT_PASSWORD=
NOTIFICACIONES_CLAVE=

# URL de la app del celular para el QR de la landing: la IP del computador en la red Wi-Fi
# PowerShell: (Get-NetIPAddress -AddressFamily IPv4 -InterfaceAlias Wi-Fi).IPAddress
MOVIL_URL=http://192.168.1.2:8080/movil/
